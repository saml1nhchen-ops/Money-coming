# Copy to ignored .env or use your hosting platform's secret manager.
# Never send real values in chat or commit them.
SIGNAL_BAI_API_KEY=
# At least 16 characters. This signs into the shared team workspace, not B.AI.
SIGNAL_WORKSPACE_PASSWORD=
# Public HTTPS backend hostname, without scheme or path.
SIGNAL_PUBLIC_HOST=api.example.com
SIGNAL_DAILY_CALL_LIMIT=126
# Optional exact IDs, only if they exist in your B.AI catalog:
# SIGNAL_GPT_MODEL=
# SIGNAL_GEMINI_MODEL=
# Optional Claude: uses a fixed Haiku-family ID from the real catalog when available.
# SIGNAL_CLAUDE_MODEL=

# Direct providers: missing keys are skipped. Doubao also requires MODEL.

# OpenAI
SIGNAL_OPENAI_API_KEY=
SIGNAL_OPENAI_MODEL=
# Default: gpt-5
SIGNAL_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
SIGNAL_ANTHROPIC_API_KEY=
SIGNAL_ANTHROPIC_MODEL=
# Default: claude-sonnet-4-5
SIGNAL_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Gemini
SIGNAL_GEMINI_API_KEY=
SIGNAL_GEMINI_MODEL=
# Default: gemini-3.5-flash
SIGNAL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Perplexity
SIGNAL_PERPLEXITY_API_KEY=
SIGNAL_PERPLEXITY_MODEL=
# Default: sonar
SIGNAL_PERPLEXITY_BASE_URL=https://api.perplexity.ai

# DeepSeek
SIGNAL_DEEPSEEK_API_KEY=
SIGNAL_DEEPSEEK_MODEL=
# Default: deepseek-chat
SIGNAL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen
SIGNAL_QWEN_API_KEY=
SIGNAL_QWEN_MODEL=
# Default: qwen-plus
SIGNAL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱
SIGNAL_ZHIPU_API_KEY=
SIGNAL_ZHIPU_MODEL=
# Default: glm-4.7-flash (paid override: glm-4.6)
SIGNAL_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Kimi
SIGNAL_KIMI_API_KEY=
SIGNAL_KIMI_MODEL=
# Default: kimi-k2-0905-preview
SIGNAL_KIMI_BASE_URL=https://api.moonshot.cn/v1

# 豆包
SIGNAL_DOUBAO_API_KEY=
SIGNAL_DOUBAO_MODEL=
SIGNAL_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# MiniMax
SIGNAL_MINIMAX_API_KEY=
SIGNAL_MINIMAX_MODEL=
# Default: MiniMax-M2
SIGNAL_MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 混元
SIGNAL_HUNYUAN_API_KEY=
SIGNAL_HUNYUAN_MODEL=
# Default: hunyuan-lite (historically free; paid override: hunyuan-turbos-latest)
SIGNAL_HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# B.AI
SIGNAL_BAI_MODEL=
# Default: gpt-5
SIGNAL_BAI_BASE_URL=https://api.b.ai/v1

# Shared gateway credentials; never put keys in browser settings.
SIGNAL_NVIDIA_API_KEY=
SIGNAL_SILICONFLOW_API_KEY=
SIGNAL_ERNIE_ROUTE=auto
SIGNAL_ERNIE_OFFICIAL_MODEL=
SIGNAL_SPARK_ROUTE=auto
SIGNAL_SPARK_OFFICIAL_MODEL=
SIGNAL_GROK_ROUTE=auto
SIGNAL_GROK_OFFICIAL_MODEL=
SIGNAL_MISTRAL_ROUTE=auto
SIGNAL_MISTRAL_OFFICIAL_MODEL=
SIGNAL_OPENROUTER_ROUTE=auto
SIGNAL_OPENROUTER_OFFICIAL_MODEL=
SIGNAL_CUSTOM_ROUTE=auto
SIGNAL_CUSTOM_OFFICIAL_MODEL=
SIGNAL_OPENAI_ROUTE=auto
SIGNAL_OPENAI_OFFICIAL_MODEL=
SIGNAL_ANTHROPIC_ROUTE=auto
SIGNAL_ANTHROPIC_OFFICIAL_MODEL=
SIGNAL_GEMINI_ROUTE=auto
SIGNAL_GEMINI_OFFICIAL_MODEL=
SIGNAL_PERPLEXITY_ROUTE=auto
SIGNAL_PERPLEXITY_OFFICIAL_MODEL=
SIGNAL_DEEPSEEK_ROUTE=auto
SIGNAL_DEEPSEEK_OFFICIAL_MODEL=
SIGNAL_DEEPSEEK_NVIDIA_NIM_MODEL=
SIGNAL_QWEN_ROUTE=auto
SIGNAL_QWEN_OFFICIAL_MODEL=
SIGNAL_QWEN_SILICONFLOW_MODEL=
SIGNAL_QWEN_NVIDIA_NIM_MODEL=
SIGNAL_ZHIPU_ROUTE=auto
SIGNAL_ZHIPU_OFFICIAL_MODEL=
SIGNAL_ZHIPU_SILICONFLOW_MODEL=
SIGNAL_KIMI_ROUTE=auto
SIGNAL_KIMI_OFFICIAL_MODEL=
SIGNAL_KIMI_NVIDIA_NIM_MODEL=
SIGNAL_DOUBAO_ROUTE=auto
SIGNAL_DOUBAO_OFFICIAL_MODEL=
SIGNAL_MINIMAX_ROUTE=auto
SIGNAL_MINIMAX_OFFICIAL_MODEL=
SIGNAL_MINIMAX_OPENROUTER_MODEL=
SIGNAL_MINIMAX_NVIDIA_NIM_MODEL=
SIGNAL_HUNYUAN_ROUTE=auto
SIGNAL_HUNYUAN_OFFICIAL_MODEL=
SIGNAL_BAI_ROUTE=auto
SIGNAL_BAI_OFFICIAL_MODEL=
SIGNAL_ERNIE_API_KEY=
SIGNAL_ERNIE_MODEL=
SIGNAL_ERNIE_BASE_URL=
SIGNAL_SPARK_API_KEY=
SIGNAL_SPARK_MODEL=
SIGNAL_SPARK_BASE_URL=
SIGNAL_GROK_API_KEY=
SIGNAL_GROK_MODEL=
SIGNAL_GROK_BASE_URL=
SIGNAL_MISTRAL_API_KEY=
SIGNAL_MISTRAL_MODEL=
SIGNAL_MISTRAL_BASE_URL=
SIGNAL_OPENROUTER_API_KEY=
SIGNAL_OPENROUTER_MODEL=
SIGNAL_OPENROUTER_BASE_URL=
SIGNAL_CUSTOM_API_KEY=
SIGNAL_CUSTOM_MODEL=
SIGNAL_CUSTOM_BASE_URL=

# GEO sampling limits (no automatic retries)
SIGNAL_GEO_CONCURRENCY=16
SIGNAL_GEO_PROVIDER_CONCURRENCY=4
SIGNAL_MAX_TOKENS=3000
SIGNAL_CALL_TIMEOUT=90
SIGNAL_GEO_THINKING=0
